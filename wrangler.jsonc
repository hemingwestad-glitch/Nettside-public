{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hemingwestad",
  "compatibility_date": "2026-05-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    // Ukjente adresser får 404.html i stedet for en tom side
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
